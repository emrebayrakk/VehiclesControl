@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeState ThemeState

<MudThemeProvider @ref="_themeProvider" Theme="AppTheme.Theme" IsDarkMode="ThemeState.IsDark" />
<MudPopoverProvider />
<MudDialogProvider CloseButton="true" BackdropClick="false" MaxWidth="MaxWidth.Small" FullWidth="true" CloseOnEscapeKey="true" />
<MudSnackbarProvider />

<AuthorizeView Context="auth">
    <Authorized>
        <MudLayout>
            <MudAppBar Elevation="0" Class="app-bar" Gutters="true">
                <MudIconButton Icon="@Icons.Material.Rounded.Menu" Edge="Edge.Start" Color="Color.Inherit" Class="mr-2"
                               OnClick="() => _drawerOpen = !_drawerOpen" aria-label="Menüyü aç veya kapat" />
                @if (IsSuperAdmin(auth.User))
                {
                    <div class="appbar-title">Sistem yönetimi</div>
                    <MudSpacer />
                }
                else
                {
                    <GlobalSearch />
                    <MudSpacer />
                    <QuickCreate />
                    <NotificationBell />
                }
                <MudTooltip Text="@(ThemeState.IsDark ? "Açık tema" : "Koyu tema")">
                    <MudIconButton Icon="@(ThemeState.IsDark ? Icons.Material.Rounded.LightMode : Icons.Material.Rounded.DarkMode)"
                                   Color="Color.Inherit" OnClick="ThemeState.ToggleAsync" aria-label="Temayı değiştir" />
                </MudTooltip>
            </MudAppBar>

            <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Never" Elevation="0" Variant="DrawerVariant.Responsive"
                       Breakpoint="Breakpoint.Md" Class="app-drawer">
                <NavMenu />
            </MudDrawer>

            <MudMainContent Class="app-main">
                <div class="page-container">
                    @Body
                </div>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <Authorizing>
        <div class="full-center"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
    </Authorizing>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private MudThemeProvider? _themeProvider;
    private bool _drawerOpen = true;

    protected override void OnInitialized() => ThemeState.Changed += OnThemeChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _themeProvider is not null)
            await ThemeState.EnsureLoadedAsync(_themeProvider);
    }

    private static bool IsSuperAdmin(System.Security.Claims.ClaimsPrincipal user) => user.IsInRole(nameof(UserRole.SuperAdmin));

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => ThemeState.Changed -= OnThemeChanged;
}
